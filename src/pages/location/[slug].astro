---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/locations.json';
import ccaaData from '../../data/ccaa-events.json';

export function getStaticPaths() {
    return data.places.map((p) => ({
        params: { slug: p.slug },
        props: { place: p },
    }));
}

const { place } = Astro.props;

const typeLabel =
    place.type === 'total' ? 'Totalidad' : place.type === 'edge' ? 'Borde' : 'Parcial';
const typeDesc =
    place.type === 'total'
        ? 'El Sol desaparece por completo'
        : place.type === 'edge'
          ? 'Rozando la totalidad'
          : 'Eclipse parcial — fuera de la franja';

const ccaaEntry = (ccaaData as { ccaa: string; descripcion: string; enlace_oficial: string; fuente: string; puntos_observacion: number; puntos_informacion: number; puntos: { nombre: string; duracion: string }[]; eventos: { nombre: string; url: string }[] }[]).find((c) => c.ccaa === place.region);

const hasDetails = place.description && place.description.length > 0;

const scheduleRows: { label: string; time: string }[] = [];
if (place.schedule) {
    if (place.schedule.partialStart) scheduleRows.push({ label: 'Inicio parcial', time: place.schedule.partialStart });
    if (place.type !== 'partial' && place.schedule.totalityStart) scheduleRows.push({ label: 'Inicio totalidad', time: place.schedule.totalityStart });
    if (place.type !== 'partial' && place.schedule.totalityEnd) scheduleRows.push({ label: 'Fin totalidad', time: place.schedule.totalityEnd });
    if (place.schedule.partialEnd) scheduleRows.push({ label: 'Fin eclipse', time: place.schedule.partialEnd });
}
---

<Layout
    title={`${place.city} · ECLIPSARIUM`}
    description={hasDetails ? place.description : `Guía del eclipse solar en ${place.city}: horarios, mejores lugares de observación y consejos.`}
>
    <main class="location" id="main-content">
        <div class="shell">
            <nav aria-label="Navegación">
                <a href="/#donde" class="location__back">← Volver al mapa</a>
            </nav>

            <header class="location__head">
                <span class="eyebrow">{place.region}</span>
                <h1 class="location__title">{place.city}</h1>
                <span
                    class="location__type location__type--{place.type}"
                    role="text"
                >
                    <span class="sr-only">Eclipse </span>{typeLabel}
                </span>
            </header>

            <div class="location__stats" aria-label="Datos del eclipse">
                <div class="stat">
                    <span class="stat__label">Duración</span>
                    <span class="stat__value">{place.duration}</span>
                </div>
                <div class="stat">
                    <span class="stat__label">Contacto</span>
                    <span class="stat__value">{place.contact}</span>
                </div>
                <div class="stat">
                    <span class="stat__label">Tipo</span>
                    <span class="stat__value">{typeDesc}</span>
                </div>
                
            </div>

            {
                hasDetails ? (
                    <>
                        <section aria-labelledby="desc-heading">
                            <h2 id="desc-heading" class="section__title">Sobre {place.city}</h2>
                            <p class="location__desc">{place.description}</p>
                        </section>

                        {scheduleRows.length > 0 && (
                            <section aria-labelledby="schedule-heading" class="location__section">
                                <h2 id="schedule-heading" class="section__title">Horario del eclipse</h2>
                                <div class="location__schedule" role="table" aria-label="Horario del eclipse en {place.city}">
                                    {scheduleRows.map((row) => (
                                        <div class="schedule__row" role="row">
                                            <span class="schedule__label" role="cell">{row.label}</span>
                                            <span class="schedule__time" role="cell">{row.time} h</span>
                                        </div>
                                    ))}
                                </div>
                            </section>
                        )}

                        {place.bestSpots && place.bestSpots.length > 0 && (
                            <section aria-labelledby="spots-heading" class="location__section">
                                <h2 id="spots-heading" class="section__title">Mejores lugares para verlo</h2>
                                <ul class="location__spots">
                                    {place.bestSpots.map((spot: string) => (
                                        <li class="spot__item">{spot}</li>
                                    ))}
                                </ul>
                            </section>
                        )}

                        {place.localEvents && place.localEvents.length > 0 && (
                            <section aria-labelledby="events-heading" class="location__section">
                                <h2 id="events-heading" class="section__title">Eventos y actividades</h2>
                                <ul class="location__events">
                                    {place.localEvents.map((evt: { name: string; url: string }) => (
                                        <li class="event__item">
                                            <a
                                                href={evt.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="event__link"
                                            >
                                                {evt.name}
                                                <svg
                                                    class="event__icon"
                                                    width="12"
                                                    height="12"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M7 17L17 7" />
                                                    <path d="M7 7H17V17" />
                                                </svg>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )}

                        {place.officialUrl && (
                            <footer class="location__footer">
                                <a
                                    href={place.officialUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="official-link"
                                >
                                    Información oficial de {place.region}
                                    <svg
                                        class="official-link__icon"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        aria-hidden="true"
                                    >
                                        <path d="M7 17L17 7" />
                                        <path d="M7 7H17V17" />
                                    </svg>
                                </a>
                            </footer>
                        )}

                        {ccaaEntry && (
                            <section aria-labelledby="ccaa-heading" class="location__section">
                                <h2 id="ccaa-heading" class="section__title">
                                    Puntos de observación en {place.region}
                                </h2>
                                <p class="location__ccaa-desc">
                                    {ccaaEntry.descripcion}
                                </p>
                                <p class="location__ccaa-count">
                                    {ccaaEntry.puntos_observacion} punto{ccaaEntry.puntos_observacion !== 1 ? 's' : ''} de observación
                                    {ccaaEntry.puntos_informacion > 0 && <> · {ccaaEntry.puntos_informacion} de información</>}
                                </p>

                                <div class="location__ccaa-table-wrap">
                                    <table class="location__ccaa-table">
                                        <thead>
                                            <tr>
                                                <th>Localidad</th>
                                                <th>Duración totalidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {ccaaEntry.puntos.map((p) => (
                                                <tr>
                                                    <td>{p.nombre}</td>
                                                    <td class="location__ccaa-dur">{p.duracion}</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>

                                {ccaaEntry.eventos.length > 0 && (
                                    <ul class="location__ccaa-events">
                                        {ccaaEntry.eventos.map((ev) => (
                                            <li>
                                                <a
                                                    href={ev.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="event__link"
                                                >
                                                    {ev.nombre}
                                                    <svg class="event__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M7 17L17 7" />
                                                        <path d="M7 7H17V17" />
                                                    </svg>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}

                                <p class="location__ccaa-source">
                                    Fuente: <a href={ccaaEntry.enlace_oficial} target="_blank" rel="noopener noreferrer">{ccaaEntry.fuente}</a>
                                </p>
                            </section>
                        )}
                    </>
                ) : (
                    <div class="location__notice" role="status">
                        <p class="notice__text">
                            Pronto tendremos información detallada sobre cómo ver el eclipse desde{' '}
                            <strong>{place.city}</strong>.
                        </p>
                        <a href="/#donde" class="notice__cta">← Regresar al mapa</a>
                    </div>
                )
            }
        </div>
    </main>
</Layout>

<style>
    .location {
        padding-block: var(--section-y);
        position: relative;
        z-index: 1;
        min-height: 100vh;
    }

    .location__back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        text-decoration: none;
        transition: color 0.3s var(--ease);
        margin-bottom: 2rem;
    }

    .location__back:hover {
        color: var(--space-blue);
    }

    .location__head {
        margin-bottom: 2rem;
    }

    .location__title {
        font-size: var(--step-3);
        margin-top: 0.6rem;
    }

    .location__type {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        padding: 0.35rem 0.8rem;
        border-radius: 0.2rem;
        margin-top: 1rem;
    }

    .location__type--total {
        color: var(--void);
        background: var(--space-blue);
    }

    .location__type--edge {
        color: var(--bone);
        background: var(--edge-blue);
    }

    .location__type--partial {
        color: var(--muted);
        background: var(--ink-soft);
    }

    .location__stats {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 3rem;
        padding: 1.5rem 2rem;
        background: var(--ink-soft);
        border-radius: var(--radius);
        border: 1px solid var(--line);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .stat__label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--muted-deep);
    }

    .stat__value {
        font-size: var(--step-1);
        font-weight: 500;
    }

    .section__title {
        font-size: var(--step-1);
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.5rem;
    }

    .location__desc {
        color: var(--bone-dim);
        font-weight: 300;
        line-height: 1.8;
        max-width: 60ch;
    }

    .location__section {
        margin-top: 3rem;
    }

    .location__schedule {
        display: grid;
        gap: 0.5rem;
        max-width: 24rem;
    }

    .schedule__row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 1rem;
        background: var(--ink-soft);
        border-radius: 0.3rem;
        border: 1px solid var(--line);
    }

    .schedule__label {
        font-family: var(--font-mono);
        font-size: var(--step--1);
        color: var(--muted);
    }

    .schedule__time {
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--space-blue);
    }

    .location__spots {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0.6rem;
    }

    .spot__item {
        padding: 0.8rem 1rem;
        background: var(--ink-soft);
        border-radius: 0.3rem;
        border: 1px solid var(--line);
        color: var(--bone-dim);
        font-weight: 300;
        line-height: 1.5;
    }

    .spot__item::before {
        content: "✦";
        margin-right: 0.6rem;
        color: var(--space-blue);
    }

    .location__events {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0.6rem;
    }

    .event__item {
        padding: 0.8rem 1rem;
        background: var(--ink-soft);
        border-radius: 0.3rem;
        border: 1px solid var(--line);
    }

    .event__link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--space-blue);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s var(--ease);
    }

    .event__link:hover {
        color: var(--space-blue-light);
    }

    .event__icon {
        flex-shrink: 0;
        opacity: 0.6;
        transition: opacity 0.3s var(--ease);
    }

    .event__link:hover .event__icon {
        opacity: 1;
    }

    .location__footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
    }

    .official-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        text-decoration: none;
        transition: color 0.3s var(--ease);
    }

    .official-link:hover {
        color: var(--space-blue);
    }

    .official-link__icon {
        flex-shrink: 0;
        opacity: 0.5;
    }

    .official-link:hover .official-link__icon {
        opacity: 1;
    }

    .location__notice {
        background: var(--ink-soft);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 2.5rem;
        max-width: 54ch;
    }

    .notice__text {
        color: var(--bone-dim);
        font-weight: 300;
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .notice__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        color: var(--space-blue);
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: var(--step--1);
        transition: color 0.3s var(--ease);
    }

    .notice__cta:hover {
        color: var(--space-blue-light);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    @media (max-width: 560px) {
        .location__stats {
            flex-direction: column;
            gap: 1rem;
            padding: 1.2rem 1.4rem;
        }

        .location__notice {
            padding: 1.5rem;
        }
    }

    .location__ccaa-desc {
        color: var(--bone-dim);
        font-weight: 300;
        line-height: 1.7;
        max-width: 60ch;
    }

    .location__ccaa-count {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--space-blue);
        margin-top: 0.6rem;
    }

    .location__ccaa-table-wrap {
        margin-top: 1rem;
        overflow-x: auto;
    }

    .location__ccaa-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--step--1);
    }

    .location__ccaa-table th {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--muted-deep);
        text-align: left;
        padding: 0.4rem 0.6rem 0.4rem 0;
        border-bottom: 1px solid var(--line);
    }

    .location__ccaa-table td {
        padding: 0.4rem 0.6rem 0.4rem 0;
        border-bottom: 1px solid var(--line);
        color: var(--bone-dim);
    }

    .location__ccaa-dur {
        font-family: var(--font-mono);
        color: var(--space-blue);
        white-space: nowrap;
    }

    .location__ccaa-events {
        list-style: none;
        padding: 0;
        margin-top: 1rem;
        display: grid;
        gap: 0.6rem;
    }

    .location__ccaa-events li {
        padding: 0.8rem 1rem;
        background: var(--ink-soft);
        border-radius: 0.3rem;
        border: 1px solid var(--line);
    }

    .location__ccaa-source {
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--muted-deep);
    }

    .location__ccaa-source a {
        color: var(--space-blue);
    }
</style>
